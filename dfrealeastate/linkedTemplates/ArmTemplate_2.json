{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dfrealeastate"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/df_load_dim_agent')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_sql_agents",
								"type": "DatasetReference"
							},
							"name": "souceagent",
							"description": "source agent "
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_dim_agent",
								"type": "DatasetReference"
							},
							"name": "sink1",
							"rejectedDataLinkedService": {
								"referenceName": "LS_ADLS",
								"type": "LinkedServiceReference"
							}
						}
					],
					"transformations": [
						{
							"name": "filteragent",
							"description": "Add exprestsion for the filter"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "aggregate1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          AgentID as string,",
						"          AgentName as string,",
						"          Region as string,",
						"          City as string,",
						"          JoinDate as date,",
						"          ExperienceYears as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> souceagent",
						"souceagent filter(!isNull(AgentID)) ~> filteragent",
						"filteragent derive(AgentName = upper(trim(AgentName)),",
						"          City = upper(trim(City)),",
						"          Region = upper(trim(Region))) ~> derivedColumn1",
						"derivedColumn1 aggregate(groupBy(AgentID),",
						"     AgentName = first(AgentName),",
						"          City = first(City),",
						"          Region = first(Region)) ~> aggregate1",
						"aggregate1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          AgentKey as integer,",
						"          AgentID as string,",
						"          AgentName as string,",
						"          Region as string,",
						"          City as string,",
						"          JoinDate as date,",
						"          ExperienceYears as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_load_dim_properties')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_clean_properties",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_dim_property",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "aggregate1"
						},
						{
							"name": "derivedColumn1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          PropertyID as string,",
						"          PropertyType as string,",
						"          City as string,",
						"          Region as string,",
						"          Bedrooms as integer,",
						"          Bathrooms as integer,",
						"          AreaSqft as decimal(10,2),",
						"          YearBuilt as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"derivedColumn1 aggregate(groupBy(PropertyID),",
						"     PropertyType = first(PropertyType),",
						"          City = first(City),",
						"          Region = first(Region),",
						"          Bedrooms = max(Bedrooms),",
						"          Bathrooms = max(Bathrooms),",
						"          AreaSqft = max(AreaSqft)) ~> aggregate1",
						"source1 derive(Bedrooms = toInteger(Bedrooms),",
						"          Bathrooms = toInteger(Bathrooms),",
						"          AreaSqft = toDecimal(AreaSqft,10,2)) ~> derivedColumn1",
						"aggregate1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          PropertyKey as integer,",
						"          PropertyID as string,",
						"          Region as string,",
						"          City as string,",
						"          PropertyType as string,",
						"          Bedrooms as integer,",
						"          Bathrooms as integer,",
						"          AreaSqft as integer,",
						"          YearBuilt as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          PropertyID,",
						"          Region,",
						"          City,",
						"          PropertyType,",
						"          Bedrooms,",
						"          Bathrooms,",
						"          AreaSqft",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
