		{
			"name": "[concat(parameters('factoryName'), '/df_Load_FactTransactions')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_sql_transctions",
								"type": "DatasetReference"
							},
							"name": "source1"
						},
						{
							"dataset": {
								"referenceName": "ds_dim_agent",
								"type": "DatasetReference"
							},
							"name": "Agentdim"
						},
						{
							"dataset": {
								"referenceName": "ds_dim_property",
								"type": "DatasetReference"
							},
							"name": "propty"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_fact_tranctions",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "Agent"
						},
						{
							"name": "join1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          TransactionID as string,",
						"          ListingID as string,",
						"          AgentID as string,",
						"          PropertyID as string,",
						"          OfferDate as date,",
						"          ClosingDate as date,",
						"          SalePrice as decimal(18,2)",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source(output(",
						"          AgentKey as integer,",
						"          AgentID as string,",
						"          AgentName as string,",
						"          Region as string,",
						"          City as string,",
						"          JoinDate as date,",
						"          ExperienceYears as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> Agentdim",
						"source(output(",
						"          PropertyKey as integer,",
						"          PropertyID as string,",
						"          Region as string,",
						"          City as string,",
						"          PropertyType as string,",
						"          Bedrooms as integer,",
						"          Bathrooms as integer,",
						"          AreaSqft as integer,",
						"          YearBuilt as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> propty",
						"source1 derive(datekey = toInteger(toString(ClosingDate,'yyyyMMdd'))) ~> derivedColumn1",
						"Agentdim, derivedColumn1 join(joinType:'undefined',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> Agent",
						"propty, source1 join(propty@PropertyID == source1@PropertyID,",
						"     joinType:'inner',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> join1",
						"join1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          TransactionKey as integer,",
						"          AgentKey as integer,",
						"          PropertyKey as integer,",
						"          DateKey as integer,",
						"          SalePrice as decimal(18,2),",
						"          DaysToClose as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_sql_transctions')]",
				"[concat(variables('factoryId'), '/datasets/ds_fact_tranctions')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_Load_dim_Date')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_clean_date",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_dim_date",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "aggregate1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          ClosingDate as date",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source1 derive(DateKey = toInteger(toString(ClosingDate,'yyyyMMdd')),",
						"          FullDate = ClosingDate,",
						"          DayNumber = dayOfMonth(ClosingDate),",
						"          MonthNumbe = month(ClosingDate)) ~> derivedColumn1",
						"derivedColumn1 aggregate(groupBy(DateKey),",
						"     FullDate = first(FullDate),",
						"          DayNumber = max(DayNumber),",
						"          MonthNumbe = max(MonthNumbe)) ~> aggregate1",
						"aggregate1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          DateKey as integer,",
						"          FullDate as date,",
						"          Year as integer,",
						"          Quarter as integer,",
						"          Month as integer,",
						"          MonthName as string,",
						"          Day as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          DateKey,",
						"          FullDate",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		}
	]
