{
	"name": "pl_copy_agent",
	"properties": {
		"activities": [
			{
				"name": "copy_agent_to_staging",
				"description": "this is used to copy agent into staging table ",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "AgentID",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "AgentID",
									"type": "String",
									"physicalType": "varchar"
								}
							},
							{
								"source": {
									"name": "AgentName",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "AgentName",
									"type": "String",
									"physicalType": "varchar"
								}
							},
							{
								"source": {
									"name": "Region",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "Region",
									"type": "String",
									"physicalType": "varchar"
								}
							},
							{
								"source": {
									"name": "City",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "City",
									"type": "String",
									"physicalType": "varchar"
								}
							},
							{
								"source": {
									"name": "JoinDate",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "JoinDate",
									"type": "Date",
									"physicalType": "date"
								}
							},
							{
								"source": {
									"name": "ExperienceYears",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "ExperienceYears",
									"type": "Int32",
									"physicalType": "int"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_adls_agent",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_sql_agents",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}